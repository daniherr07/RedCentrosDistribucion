%% Diagrama de clases completo - Red de Centros de Distribucion / TicoPack
%% Logistics. Incluye atributos, metodos publicos (y los privados mas
%% relevantes) de cada clase, y el tipo de relacion rotulado en cada
%% linea (Herencia, Composicion, Agregacion, Asociacion, Dependencia).
%%
%% Nota de alcance: MenuCentros y MenuLogistica tienen muchos metodos
%% privados "hoja" que siguen el mismo patron repetitivo (registrarX,
%% buscarX, mostrarX, eliminarX, uno por cada opcion del submenu); para
%% no inflar el diagrama se muestran solo su metodo publico de entrada y
%% los orquestadores de cada submenu. El detalle linea por linea esta en
%% el codigo fuente (Menus/MenuCentros.h y Menus/MenuLogistica.h).
%%
%% No se dibujan aparte (son detalle de implementacion, no relaciones de
%% dominio): Nodo<T> y ListaEnlazada<T> (lista enlazada propia, sin STL,
%% usada por las 7 colecciones), Fecha (usada por Colaborador,
%% RegistroBitacora, SolicitudEnvio y Despacho) y Tarifas (tarifas
%% estaticas por TipoCategoria, usadas por GestionSolicitudes).
classDiagram
    direction LR

    class Menu {
        -red : RedCentros
        -reportes : Reportes
        -menuCentros : MenuCentros
        -menuLogistica : MenuLogistica
        +menuPrincipal()
        -menuReportes()
    }
    class MenuCentros {
        -red : RedCentros&
        +menu()
        -menuClientes(CentroDistribucion*)
        -menuColaboradores(CentroDistribucion*)
    }
    class MenuLogistica {
        -red : RedCentros&
        +menuGeneral()
        -menuBodegas(CentroDistribucion*)
        -menuPaquetes(CentroDistribucion*)
        -menuSolicitudes(CentroDistribucion*)
        -menuDespachos(CentroDistribucion*)
    }

    class Reportes {
        +historialCliente(CentroDistribucion*, Cliente*) string
        +clientesPorCantidadEnvios(CentroDistribucion*) string
        +bitacoraPaquete(Paquete*) string
        +consultaDespachoPaquete(CentroDistribucion*, Paquete*) string
        +ocupacionBodegas(RedCentros*) string
        +despachosPorColaborador(CentroDistribucion*, Colaborador*) string
    }

    class RedCentros {
        -centros : ListaEnlazada~CentroDistribucion*~
        +existeCodigoCentro(string) bool
        +buscarCentroPorCodigo(string) CentroDistribucion*
        +registrarCentro(...) bool
        +eliminarCentro(string) bool
        +mostrarListado() string
        +getCantidad() int
        +existeCodigoPaqueteGlobal(string) bool
        +buscarPaqueteGlobal(string) Paquete*
        +existeCodigoSolicitudGlobal(string) bool
        +buscarSolicitudGlobal(string) SolicitudEnvio*
        +existeCodigoDespachoGlobal(string) bool
        +buscarDespachoGlobal(string) Despacho*
        +cargarDatosDePrueba()
    }

    class CentroDistribucion {
        -codigo : string
        -nombre : string
        -provincia : string
        -direccion : string
        -telefono : string
        +getCodigo() string
        +getNombre() string
        +getGestionClientes() GestionClientes*
        +getGestionColaboradores() GestionColaboradores*
        +getGestionBodegas() GestionBodegas*
        +getGestionPaquetes() GestionPaquetes*
        +getGestionSolicitudes() GestionSolicitudes*
        +getGestionDespachos() GestionDespachos*
        +tieneDependencias() bool
        +eliminarCliente(string) bool
        +eliminarColaborador(string) bool
        +eliminarPaquete(string) bool
        +aprobarSolicitud(string, Colaborador*, string, string) bool
        +mostrarDatos() string
    }

    class Cliente {
        <<abstract>>
        #identificacion : string
        #nombre : string
        #telefono : string
        #correo : string
        +getIdentificacion() string
        +getNombre() string
        +getTelefono() string
        +getCorreo() string
        +aplicarDescuento(double) double
        +getTipoCliente()* string
        +mostrar() string
    }
    class ClientePersona {
        +getTipoCliente() string
    }
    class ClienteEmpresa {
        -actividadEconomica : string
        -porcentajeDescuento : double
        +getActividadEconomica() string
        +getPorcentajeDescuento() double
        +aplicarDescuento(double) double
        +getTipoCliente() string
        +mostrar() string
    }
    class GestionClientes {
        -clientes : ListaEnlazada~Cliente*~
        +existeIdentificacion(string) bool
        +buscarPorIdentificacion(string) Cliente*
        +registrarPersona(...) bool
        +registrarEmpresa(...) bool
        +eliminar(string) bool
        +mostrarListado() string
        +getCantidad() int
    }

    class Colaborador {
        -identificacion : string
        -nombreCompleto : string
        -fechaIngreso : Fecha
        -puesto : string
        +getIdentificacion() string
        +getNombreCompleto() string
        +getFechaIngreso() Fecha
        +getPuesto() string
        +mostrar() string
    }
    class GestionColaboradores {
        -colaboradores : ListaEnlazada~Colaborador*~
        +existeIdentificacion(string) bool
        +buscarPorIdentificacion(string) Colaborador*
        +registrar(...) bool
        +eliminar(string) bool
        +mostrarListado() string
        +getCantidad() int
    }

    class Celda {
        -ocupada : bool
        -paquete : Paquete*
        +estaOcupada() bool
        +getPaquete() Paquete*
        +asignar(Paquete*) bool
        +liberar() bool
    }
    class Bodega {
        -codigo : string
        -nombre : string
        -tipo : TipoCategoria
        -filas : int
        -columnas : int
        -matriz : Celda**
        +esCompatible(TipoCategoria) bool
        +existeCelda(int, int) bool
        +estaLibre(int, int) bool
        +getCelda(int, int) Celda*
        +reservarCelda(int, int, Paquete*) bool
        +liberarCelda(int, int) bool
        +totalCeldas() int
        +contarOcupadas() int
        +contarLibres() int
        +porcentajeOcupacion() double
        +porcentajeDisponible() double
        +todasLasCeldasLibres() bool
        +formatoCelda(int, int) string
        +buscarCeldaLibre(int&, int&) bool
        +mostrarMatriz() string
        -anchoIndice() int
    }
    class GestionBodegas {
        -bodegas : ListaEnlazada~Bodega*~
        +existeCodigo(string) bool
        +buscarPorCodigo(string) Bodega*
        +registrarBodega(...) bool
        +eliminar(string) bool
        +mejorBodegaCompatible(TipoCategoria) Bodega*
        +mostrarListado() string
        +getCantidad() int
    }

    class RegistroBitacora {
        -estadoAnterior : EstadoPaquete
        -estadoNuevo : EstadoPaquete
        -fecha : Fecha
        -responsable : Colaborador*
        +getEstadoAnterior() EstadoPaquete
        +getEstadoNuevo() EstadoPaquete
        +getFecha() Fecha
        +getResponsable() Colaborador*
        +mostrar() string
    }
    class Paquete {
        -codigo : string
        -descripcion : string
        -peso : double
        -categoria : TipoCategoria
        -estado : EstadoPaquete
        -estadoPrevioIncidencia : EstadoPaquete
        -fila : int
        -columna : int
        +getCodigo() string
        +getEstado() EstadoPaquete
        +getBodegaAsignada() Bodega*
        +tieneUbicacion() bool
        +asignarUbicacion(Bodega*, int, int)
        +liberarUbicacion()
        +transicionValida(EstadoPaquete, EstadoPaquete)$ bool
        +cambiarEstado(EstadoPaquete, Colaborador*) bool
        +reportarIncidencia(Colaborador*) bool
        +mostrarBitacora() string
        +mostrar() string
    }
    class GestionPaquetes {
        -paquetes : ListaEnlazada~Paquete*~
        +existeCodigo(string) bool
        +buscarPorCodigo(string) Paquete*
        +registrarPaquete(...) Paquete*
        +eliminar(string) bool
        +almacenarPaquete(Paquete*, Bodega*, int, int, Colaborador*) bool
        +reubicarPaquete(Paquete*, Bodega*, int, int) bool
        +reportarIncidencia(string, Colaborador*) bool
        +resolverIncidencia(string, Colaborador*) bool
        +mostrarListado() string
        +getCantidad() int
    }

    class SolicitudEnvio {
        -codigo : string
        -destino : string
        -fechaSolicitud : Fecha
        -costoEstimado : double
        -estado : EstadoSolicitud
        +getCodigo() string
        +getCostoEstimado() double
        +getEstado() EstadoSolicitud
        +cambiarEstado(EstadoSolicitud) bool
        +mostrar() string
    }
    class GestionSolicitudes {
        -solicitudes : ListaEnlazada~SolicitudEnvio*~
        +existeCodigo(string) bool
        +buscarPorCodigo(string) SolicitudEnvio*
        +existePendienteParaPaquete(Paquete*) bool
        +existeAprobadaParaPaquete(Paquete*) bool
        +crearSolicitud(...) SolicitudEnvio*
        +rechazar(string) bool
