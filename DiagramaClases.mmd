%% Diagrama de clases (completo, version simplificada) - Red de Centros
%% de Distribucion / TicoPack Logistics. Cada clase muestra solo sus
%% atributos mas identificativos (sin metodos ni etiquetas de relacion)
%% para que se lea de un vistazo; el codigo fuente tiene el detalle.
classDiagram
    direction LR

    class RedCentros {
        -centros
    }
    class CentroDistribucion {
        -codigo
        -nombre
        -provincia
        -telefono
    }

    class Cliente {
        <<abstract>>
        -identificacion
        -nombre
        -telefono
        -correo
    }
    class ClientePersona
    class ClienteEmpresa {
        -actividadEconomica
        -porcentajeDescuento
    }
    class GestionClientes {
        -clientes
    }

    class Colaborador {
        -identificacion
        -nombreCompleto
        -puesto
    }
    class GestionColaboradores {
        -colaboradores
    }

    class Celda {
        -ocupada
        -paquete
    }
    class Bodega {
        -codigo
        -tipo
        -filas
        -columnas
        -matriz
    }
    class GestionBodegas {
        -bodegas
    }

    class RegistroBitacora {
        -estadoAnterior
        -estadoNuevo
        -fecha
        -responsable
    }
    class Paquete {
        -codigo
        -descripcion
        -peso
        -categoria
        -estado
    }
    class GestionPaquetes {
        -paquetes
    }

    class SolicitudEnvio {
        -codigo
        -destino
        -costoEstimado
        -estado
    }
    class GestionSolicitudes {
        -solicitudes
    }

    class Despacho {
        -codigo
        -hora
        -estado
    }
    class GestionDespachos {
        -despachos
    }

    class Reportes

    class Menu
    class MenuCentros
    class MenuLogistica

    %% ---- Herencia ----
    Cliente <|-- ClientePersona
    Cliente <|-- ClienteEmpresa

    %% ---- Composicion (el todo crea y destruye a la parte) ----
    RedCentros *-- CentroDistribucion
    CentroDistribucion *-- GestionClientes
    CentroDistribucion *-- GestionColaboradores
    CentroDistribucion *-- GestionBodegas
    CentroDistribucion *-- GestionPaquetes
    CentroDistribucion *-- GestionSolicitudes
    CentroDistribucion *-- GestionDespachos
    Bodega *-- Celda
    Paquete *-- RegistroBitacora
    Menu *-- RedCentros
    Menu *-- Reportes
    Menu *-- MenuCentros
    Menu *-- MenuLogistica

    %% ---- Agregacion (administra una coleccion de, sin ser el creador conceptual) ----
    GestionClientes o-- Cliente
    GestionColaboradores o-- Colaborador
    GestionBodegas o-- Bodega
    GestionPaquetes o-- Paquete
    GestionSolicitudes o-- SolicitudEnvio
    GestionDespachos o-- Despacho

    %% ---- Asociacion / dependencia (solo referencia, no es dueno) ----
    Celda --> Paquete
    Paquete --> Cliente
    Paquete --> Bodega
    RegistroBitacora --> Colaborador
    SolicitudEnvio --> Paquete
    SolicitudEnvio --> Cliente
    SolicitudEnvio --> Colaborador
    Despacho --> SolicitudEnvio
    Despacho --> Paquete
    Despacho --> Colaborador
    Reportes --> RedCentros
    MenuCentros --> RedCentros
    MenuLogistica --> RedCentros
